---
/**
 * Projects index.
 * "Projects." + "©2026" + subtext + category filter pills (Category / UI/UX
 * Design / Web design / Development / Branding) + the project grid.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CTASection from "../components/CTASection.astro";
import { PROJECTS, PROJECT_CATEGORIES } from "../data/projects";

const title = "Projects";
const description =
  "A young studio, deliberately. We take on a limited number of projects so each one gets real strategic attention — here's the work.";
---

<BaseLayout title={title} description={description}>
  <section class="page-intro">
    <div class="container page-intro__inner">
      <div class="page-intro__title-row">
        <h1 class="page-intro__title">Projects.</h1>
        <span class="page-intro__period">©2026</span>
      </div>
      <p class="page-intro__subtext">
        A young studio, deliberately. We take on a limited number of projects so each one gets real strategic attention — here's the work, including the products we build for ourselves.
      </p>
    </div>
  </section>

  <section class="section container projects-index">
    <div class="projects-index__filters" role="tablist" aria-label="Filter projects by category" data-filters>
      <button class="projects-index__filter is-active" type="button" role="tab" aria-selected="true" data-filter="Category">
        Category
      </button>
      {PROJECT_CATEGORIES.map((cat) => (
        <button class="projects-index__filter" type="button" role="tab" aria-selected="false" data-filter={cat}>
          {cat}
        </button>
      ))}
    </div>

    <div class="projects-index__grid" data-project-grid>
      {PROJECTS.map((project) => (
        <div data-project-scope={project.scope.join("|")}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .page-intro {
    padding-top: calc(var(--header-height) + 90px);
    padding-bottom: var(--space-11);
    background: var(--color-bg-black);
  }

  .page-intro__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 900px;
  }

  .page-intro__title-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  .page-intro__title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tighter);
    letter-spacing: var(--ls-tightest);
    color: var(--color-text-inverse);
  }

  .page-intro__period {
    font-size: var(--fs-h4);
    color: var(--color-text-inverse-muted);
  }

  .page-intro__subtext {
    max-width: 40rem;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
    color: var(--color-text-inverse-secondary);
  }

  .projects-index__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--space-8);
  }

  .projects-index__filter {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-display);
    color: var(--color-text-secondary);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .projects-index__filter:hover {
    color: var(--color-text);
  }

  .projects-index__filter.is-active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .projects-index__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }

  .projects-index__grid > * {
    width: 100%;
  }

  .projects-index__grid [hidden] {
    display: none;
  }

  @media (max-width: 809px) {
    .page-intro {
      padding-top: calc(var(--header-height) + 40px);
    }

    .projects-index__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const filters = document.querySelector<HTMLElement>("[data-filters]");
  const grid = document.querySelector<HTMLElement>("[data-project-grid]");
  if (filters && grid) {
    const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-project-scope]"));

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const category = btn.dataset.filter;
        buttons.forEach((b) => {
          b.classList.toggle("is-active", b === btn);
          b.setAttribute("aria-selected", b === btn ? "true" : "false");
        });
        cards.forEach((card) => {
          const scope = card.dataset.projectScope?.split("|") ?? [];
          const show = category === "Category" || scope.includes(category ?? "");
          card.hidden = !show;
        });
      });
    });
  }
</script>
