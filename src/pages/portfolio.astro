        </article>
      </section>

      <!-- ============================================================
           05 — Case Study 1 · Overview
           ============================================================ -->
      <section class="slide-viewport">
        <article class="slide">
          <div class="slide-inner">
            <p class="eyebrow">05 / Case Study — Hospitality</p>
            <h2 class="headline headline--md">A booking site guests didn't trust.</h2>
            <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:12px;">
              <span class="chip">Hospitality</span>
              <span class="chip">8-week timeline</span>
              <span class="chip">Web design + Development</span>
            </div>
            <div class="grid grid--2" style="margin-top:20px; gap:44px; flex:1; align-items:start;">
              <div>
