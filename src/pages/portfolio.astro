---
/**
 * UiEdge Portfolio Deck — /portfolio
 *
 * A self-contained, presentation-style deck: 16 fixed 1280x720 slides,
 * vertical scroll-snap, keyboard + on-screen nav, and a "Download deck
 * (PDF)" button that captures every slide into one landscape PDF via
 * html2canvas + jsPDF. A @media print fallback (deck.css) gives a clean
 * one-slide-per-page PDF via the browser's own Print dialog.
 *
 * Deliberately does NOT use BaseLayout — the deck is its own world
 * (no site header/footer), but reuses the live site's real design
 * tokens: Inter for display/body, Geist Sans for labels (see
 * src/styles/global.css) — not the generic Space Grotesk / JetBrains
 * Mono pairing suggested in the build brief, since the live site's own
 * CSS defines Inter + Geist.
 *
 * Case studies (slides 5–8), the testimonial slide (13) and a few
 * product/company specifics are drafted placeholders — there is no real
 * client data, metrics, or quotes in this repo to pull from. Swap them
 * for real names, numbers and quotes before sending this to a client.
 */
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-sans/600.css";
import "../styles/deck.css";

const YEAR = "2026";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Portfolio Deck — UiEdge</title>
    <meta
      name="description"
      content="UiEdge — a strategy-first digital product studio. Portfolio deck: process, case studies, products, and how to work with us."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  </head>
  <body>
    <div class="deck-progress" data-deck-progress style="width:0%"></div>

    <div class="deck">
      <!-- ============================================================
           01 — Cover / Hero
           ============================================================ -->
      <section class="slide-viewport">
        <article class="slide slide--cover">
          <div class="slide-inner">
            <div class="cover-top deck-fade-up">
              <img class="logo-mark" src="/images/logo/uiedge-white.png" alt="UiEdge" style="height:100px; width:auto;" />
              <span class="cover-date">Portfolio · {YEAR}</span>
            </div>
            <div>
              <p class="eyebrow deck-fade-up">01 / Studio</p>
              <h1 class="cover-headline deck-fade-up deck-fade-up--delay-1">
                From Digitalization to Automation, We Build Around Your Vision.
              </h1>
              <p class="cover-sub deck-fade-up deck-fade-up--delay-2">
                A strategy-first digital product studio — we design and build websites, apps, and SaaS products
                where design is business strategy.
              </p>
            </div>
          </div>
          <div class="footer-strip">
            <span>uiedge.in</span>
            <span>Kozhikode, India · {YEAR}</span>
            <span class="footer-strip__num">01 / 16</span>
          </div>
        </article>
      </section>

      <!-- ============================================================
           02 — About UiEdge
           ============================================================ -->
      <section class="slide-viewport">
        <article class="slide">
          <div class="slide-inner">
            <p class="eyebrow">02 / About</p>
            <h2 class="headline headline--lg">We're not a design agency.</h2>
            <div class="grid grid--2" style="margin-top:28px; gap:48px; flex:1;">
              <div>
                <p class="body-copy">
                  UiEdge is a strategy-first digital product studio based in Kozhikode, Kerala. Design, to us, is
                  business strategy — every engagement starts from business goals, user psychology, and
                  scalability, and is measured against real outcomes: conversions, adoption, efficiency, brand
                  perception.
                </p>
                <p class="body-copy">
                  What sets us apart: we don't only design for clients — we build and run our own software
                  alongside client work, including a veterinary management platform and a point-of-sale system.
                </p>
                <div class="grid grid--3" style="margin-top:18px; gap:14px; max-width:600px;">
                  <div class="stat-block"><div class="stat-block__num">02</div><div class="stat-block__label">Owned products in build</div></div>
                  <div class="stat-block"><div class="stat-block__num">09</div><div class="stat-block__label">Step delivery process</div></div>
                  <div class="stat-block"><div class="stat-block__num">04</div><div class="stat-block__label">Industries served so far</div></div>
                </div>
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:18px;">
                  <span class="chip">Strategy-first</span>
                  <span class="chip">Design + build, one team</span>
                  <span class="chip">Kozhikode → Pan-India → Gulf → Global</span>
                </div>
              </div>
              <div style="border-radius:16px; overflow:hidden; align-self:stretch;">
                <img
                  src="/images/deck/about-team.jpg"
                  alt="Studio workspace"
                  style="width:100%; height:100%; object-fit:cover;"
                />
              </div>
            </div>
          </div>
          <div class="footer-strip">
            <span>uiedge.in</span>
            <span>admin@uiedge.in</span>
            <span class="footer-strip__num">02 / 16</span>
          </div>
        </article>
      </section>

      <!-- ============================================================
           03 — What We Do
           ============================================================ -->
      <section class="slide-viewport">
        <article class="slide">
          <div class="slide-inner">
            <p class="eyebrow">03 / What We Do</p>
