<script>
  // Services accordion — single-open
  const services = document.querySelector("[data-services]");
  if (services) {
    const items = Array.from(services.querySelectorAll<HTMLElement>("[data-service-item]"));
    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>("[data-service-trigger]");
      const panel = item.querySelector<HTMLElement>("[data-service-panel]");
      if (!trigger || !panel) return;
      trigger.addEventListener("click", () => {
        const isOpen = trigger.getAttribute("aria-expanded") === "true";
        items.forEach((other) => {
          const t = other.querySelector<HTMLButtonElement>("[data-service-trigger]");
          const p = other.querySelector<HTMLElement>("[data-service-panel]");
          if (t) t.setAttribute("aria-expanded", "false");
          if (p) p.hidden = true;
        });
        if (!isOpen) {
          trigger.setAttribute("aria-expanded", "true");
          panel.hidden = false;
        }
      });
    });
  }
</script>
