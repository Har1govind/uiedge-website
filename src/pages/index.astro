---
/**
 * Home page — section order [measured from live site]:
 * 1. Hero (includes clients marquee at bottom)
 * 2. Projects  3. Advantages (why choose us)  4. Services (accordion)
 * 5. Showreel (about)  6. Testimonials  7. Text (counters + approach)
 * 8. Bento (case study)  9. Pricing  10. Team  11. FAQ
 * 12. Blog (incl. "What's new in digital?")  13. Contact form  14. Footer
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ClientsMarquee from "../components/ClientsMarquee.astro";
import StatsSection from "../components/StatsSection.astro";
import CaseStudy from "../components/CaseStudy.astro";
import CTASection from "../components/CTASection.astro";
import FAQ from "../components/FAQ.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import PricingCard from "../components/PricingCard.astro";
import BlogCard from "../components/BlogCard.astro";
import TeamCard from "../components/TeamCard.astro";
import Showreel from "../components/Showreel.astro";
import Counter from "../components/atoms/Counter.astro";
import { PROJECTS } from "../data/projects";
import { SERVICES } from "../data/services";
import { TESTIMONIALS } from "../data/testimonials";
import { BLOG_POSTS } from "../data/blog";
import { TEAM } from "../data/team";

const title = "UiEdge | Software Development Company in Kerala, India";
const description =
  "UiEdge is a software development company in Kozhikode, Kerala. We build custom software, web and mobile apps, and SaaS products for businesses in Kerala, South India, and worldwide.";
---

<BaseLayout title={title} description={description}>
  <div class="hero-stack">
    <Hero />
    <ClientsMarquee />
  </div>

  <!-- 2. Projects -->
  <section class="section container projects">
    <div class="projects__top">
      <p class="projects__count">({PROJECTS.length})</p>
      <h2 class="projects__title">
        Projects.<span class="projects__year">©2026</span>
      </h2>
      <p class="projects__subtext">
        Client software and the products we build for ourselves. We take on a limited number of engagements so each one gets the owners’ full attention. Here's the work.
      </p>
    </div>
    <div class="projects__grid">
      {PROJECTS.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- 3. Advantages / why choose us -->
  <StatsSection />

  <!-- 4. Services (accordion) -->
  <section class="section section--padded services" id="services">
    <div class="container">
      <div class="services__top">
        <p class="services__eyebrow">Software development services</p>
        <h2 class="services__title">
          Services.<span class="services__count">({SERVICES.length})</span>
        </h2>
      </div>

      <div class="services__list" data-services>
        {SERVICES.map((service, index) => (
          <article class="services__item" data-service-item>
            <button class="services__trigger" type="button" aria-expanded="false" data-service-trigger>
              <span class="services__num">{service.number}</span>
              <span class="services__name">{service.title}</span>
              <span class="services__icon" aria-hidden="true"></span>
            </button>
            <div class="services__panel" data-service-panel hidden>
              <p class="services__desc">{service.description}</p>
              <ul class="services__chips">
                {service.categories.map((category) => (
                  <li class="services__chip">{category}</li>
                ))}
                <li class="services__count-badge">{service.count}</li>
              </ul>
            </div>
          </article>
        ))}
      </div>

      <div class="services__bottom">
        <div class="services__filler" aria-hidden="true"></div>
        <a class="btn btn--accent services__cta" href="/contact">Get started</a>
      </div>

      <div class="services__band">
        <div class="services__band-media" aria-hidden="true">
          <img src="/images/dark-bg.jpg" alt="" width="1912" height="1402" loading="lazy" decoding="async" />
          <div class="services__band-noise"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Showreel / about -->
  <section class="section showreel-sec" id="about">
    <div class="container">
      <div class="showreel-sec__top">
        <p class="showreel-sec__eyebrow">About us</p>
        <div class="showreel-sec__heading">
          <p class="showreel-sec__logo">UiEdge</p>
          <h2 class="showreel-sec__title">
            How we engineer <span class="showreel-sec__title-muted">software that performs.</span>
          </h2>
          <p class="showreel-sec__subtitle">
            From discovery to deployment and support, with strategy, design, and engineering under one roof in Kozhikode, Kerala.
          </p>
        </div>
      </div>

      <div class="showreel-sec__body">
        <ol class="showreel-sec__steps">
          <li class="showreel-sec__step">
            <span class="showreel-sec__step-num">01</span>
            <span class="showreel-sec__step-text">A team that communicates every step</span>
          </li>
          <li class="showreel-sec__step">
            <span class="showreel-sec__step-num">02</span>
            <span class="showreel-sec__step-text">Custom software built around your workflows</span>
          </li>
          <li class="showreel-sec__step">
            <span class="showreel-sec__step-num">03</span>
            <span class="showreel-sec__step-text">Transparent pricing with no hidden fees</span>
          </li>
          <li class="showreel-sec__step">
            <span class="showreel-sec__step-num">04</span>
            <span class="showreel-sec__step-text">Engineers who build and run their own products</span>
          </li>
        </ol>

        <div class="showreel-sec__media">
          <img
            class="showreel-sec__poster"
            src="/images/about-team.jpg"
            alt="The UiEdge software development team at work in Kozhikode, Kerala"
            width="2280"
            height="1350"
            loading="lazy"
            decoding="async"
          />
          <Showreel />
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Testimonials -->
  <section class="section testimonials" id="testimonials">
    <div class="container">
      <div class="testimonials__top">
        <p class="testimonials__eyebrow">Testimonials</p>
        <div class="testimonials__heading">
          <h2 class="testimonials__title">Experiences.<span class="testimonials__year">©2026</span></h2>
        </div>
      </div>

      <div class="testimonials__grid">
        <aside class="testimonials__intro">
          <div class="testimonials__intro-top">
            <div class="testimonials__score">
              <span class="testimonials__score-value"><Counter value={2} /></span>
              <span class="testimonials__score-max">projects</span>
            </div>
            <p class="testimonials__lead">
              We're early-stage and honest about it: <strong>2 client projects completed</strong> so far, plus 2 products we build and run ourselves.
            </p>
          </div>

          <div class="testimonials__bottom">
            <div class="testimonials__trusted">
              <p class="testimonials__logo">UiEdge</p>
              <div class="testimonials__ratings">
                <div class="testimonials__rating-info">
                  <p class="testimonials__trusted-text"><strong>Based in</strong> Kozhikode, Kerala, serving South India and clients worldwide</p>
                </div>
              </div>
            </div>
            <a class="testimonials__review" href="mailto:admin@uiedge.in">Ask directly →</a>
          </div>
        </aside>

        {TESTIMONIALS.map((t) => <TestimonialCard testimonial={t} />)}
      </div>
    </div>
  </section>

  <!-- 7. Text — stats counters + approach -->
  <section class="section text-sec" aria-label="Company results">
    <div class="container">
      <div class="text-sec__numbers">
        <div class="text-sec__stat">
          <span class="text-sec__value"><Counter value={9} /></span>
          <span class="text-sec__label">Step delivery process, start to finish</span>
        </div>
        <div class="text-sec__stat">
          <span class="text-sec__value"><Counter value={2} /></span>
          <span class="text-sec__label">Client projects completed so far</span>
        </div>
        <div class="text-sec__stat">
          <span class="text-sec__value"><Counter value={2} /></span>
          <span class="text-sec__label">Software products we build and run</span>
        </div>
        <div class="text-sec__stat">
          <span class="text-sec__value"><Counter value={3} /></span>
          <span class="text-sec__label">Owners working directly on every project</span>
        </div>
      </div>

      <div class="text-sec__divider" aria-hidden="true"></div>

      <div class="text-sec__approach">
        <div class="text-sec__approach-intro">
          <p class="text-sec__logo">UiEdge</p>
          <p class="text-sec__approach-lead">Every system we build is engineered for the long run.</p>
        </div>
        <div class="text-sec__approach-copy">
          <p class="text-sec__approach-text">
            Our approach is simple: we start from business goals, not a feature wishlist, and focus on reliability, speed, and clarity, so every line of code serves a clear purpose without unnecessary complexity.
          </p>
          <p class="text-sec__approach-text text-sec__approach-text--muted">
            We don’t overpromise. We ship working, maintainable software, and the products we run ourselves hold us to the same standard.
            </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Case study -->
  <CaseStudy />

  <!-- 9. Pricing -->
  <section class="section section--padded pricing" id="pricing">
    <div class="container">
      <div class="pricing__head">
        <p class="pricing__eyebrow">Simple pricing</p>
        <h2 class="pricing__title">Pricing.</h2>
      </div>
      <PricingCard />
    </div>
  </section>

  <!-- 10. Team -->
  <section class="section team" id="team">
    <div class="container team__shell">
      <div class="team__main">
        <div class="team__heading">
          <p class="team__logo">UiEdge</p>
          <h2 class="team__title">The people behind the software.</h2>
        </div>

        <div class="team__join">
          <span class="team__join-icon" aria-hidden="true"></span>
          <div class="team__join-body">
            <p class="team__join-label">Be part of our mission</p>
            <p class="team__join-text">If you’re ready to create and collaborate, we’d love to hear from you.</p>
            <a class="btn btn--dark team__apply" href="mailto:admin@uiedge.in">Apply now</a>
          </div>
        </div>
      </div>

      <div class="team__grid">
        {TEAM.map((member) => <TeamCard member={member} />)}
      </div>
    </div>
  </section>

  <!-- 11. FAQ -->
  <FAQ />

  <!-- 12. Blog + newsletter -->
  <section class="section blog" id="blog">
    <div class="container">
      <div class="blog__top">
        <h2 class="blog__title">Engineering and product insights from our team.</h2>
        <div class="blog__head-side">
          <p class="blog__subtext">Stay informed about our latest projects, products, and what we’re learning building software.</p>
          <a class="btn btn--dark blog__all" href="/blog">See all</a>
        </div>
      </div>

      <div class="blog__grid">
        {BLOG_POSTS.slice(0, 2).map((post) => <BlogCard post={post} />)}

        <div class="blog__news">
          <img
            class="blog__news-image"
            src="/images/newsletter-software.jpg"
            alt="Developer typing on a laptop"
            width="1137"
            height="825"
            loading="lazy"
            decoding="async"
          />
          <div class="blog__news-top">
            <p class="blog__news-logo">UiEdge</p>
            <span class="blog__news-plus" aria-hidden="true"></span>
          </div>
          <h3 class="blog__news-title">
            What’s new
            <span class="blog__news-title-line">in tech?</span>
          </h3>
        </div>
      </div>
    </div>
  </section>

  <!-- 13. Contact -->
  <CTASection />
</BaseLayout>

<style>
  /* --- Projects --- */
  .projects__top {
    display: grid;
    grid-template-columns: 335px 1fr 1fr;
    gap: var(--gutter);
    align-items: end;
    margin-bottom: 90px; /* [CDP-verified] */
  }

  .projects__count {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    color: var(--color-text);
    align-self: start;
  }

  .projects__title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tighter);
    letter-spacing: var(--ls-tightest);
    color: var(--color-text);
  }

  .projects__year {
    font-size: 36px;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tightest);
    color: var(--color-text);
    margin-left: var(--space-4);
  }

  .projects__subtext {
    max-width: 26rem;
    justify-self: end;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-secondary);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }

  .projects__grid > * {
    width: 100%;
  }

  /* --- Services (accordion) --- */
  .services {
    background: var(--color-bg-black);
    position: relative;
  }

  .services .container {
    position: relative;
    z-index: 1;
  }

  .services__top {
    display: grid;
    grid-template-columns: 335px 1fr;
    gap: var(--gutter);
    align-items: end;
    margin-bottom: var(--space-12);
  }

  .services__eyebrow {
    align-self: start;
    color: var(--color-text-inverse-secondary);
  }

  .services__title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tighter);
    letter-spacing: var(--ls-tightest);
    color: var(--color-text-inverse);
  }

  .services__count {
    font-size: 37px;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tightest);
    color: var(--color-text-inverse);
    margin-left: var(--space-5);
  }

  .services__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-12);
  }

  .services__item {
    border-bottom: 1px solid var(--color-border-inverse);
  }

  .services__item:first-child {
    border-top: 1px solid var(--color-border-inverse);
  }

  .services__trigger {
    display: grid;
    grid-template-columns: 100px 1fr 40px;
    gap: var(--space-5);
    align-items: start;
    width: 100%;
    padding-block: var(--space-5);
    text-align: left;
  }

  .services__num {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    color: var(--color-text-inverse);
  }

  .services__name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    line-height: 1.2;
    color: var(--color-text-inverse);
  }

  .services__trigger[aria-expanded="true"] .services__name {
    font-size: 30px;
  }

  .services__icon {
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid var(--color-text-inverse);
    margin-top: 6px;
    transition: transform var(--dur) var(--ease-out);
  }

  .services__icon::before,
  .services__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--color-text-inverse);
  }

  .services__icon::before {
    width: 9px;
    height: 1px;
    transform: translate(-50%, -50%);
  }

  .services__icon::after {
    width: 1px;
    height: 9px;
    transform: translate(-50%, -50%);
  }

  .services__trigger[aria-expanded="true"] .services__icon::after {
    display: none;
  }

  .services__panel {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-8);
    padding: 0 0 var(--space-8);
    margin-left: 100px;
  }

  .services__desc {
    flex: 1 1 320px;
    max-width: 40rem;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-inverse-secondary);
  }

  .services__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1 1 260px;
  }

  .services__chip {
    display: inline-flex;
    align-items: center;
    padding: 7px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-inverse-strong);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-display);
    line-height: 1;
    color: var(--color-text-inverse);
  }

  .services__count-badge {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    color: var(--color-accent-ink);
  }

  .services__bottom {
    display: grid;
    grid-template-columns: 335px 1fr;
    gap: var(--gutter);
  }

  .services__cta {
    justify-self: start;
    font-size: var(--fs-body);
    padding: var(--space-3) var(--space-7);
  }

  /* Full-width dark band with vignette bg — absolute, behind the content */
  .services__band {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--color-bg-black);
  }

  .services__band-media {
    position: absolute;
    inset: 0;
  }

  .services__band-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(1.15);
  }

  .services__band-noise {
    position: absolute;
    inset: -200%;
    width: 400%;
    height: 400%;
    background: url("/images/clients-pattern.png");
    opacity: 0.05;
  }

  /* --- Showreel --- */
  .showreel-sec__top {
    display: grid;
    grid-template-columns: 335px 1fr;
    gap: var(--gutter);
    align-items: start;
    margin-bottom: var(--space-10);
  }

  .showreel-sec__eyebrow {
    align-self: start;
  }

  .showreel-sec__logo {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-display);
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .showreel-sec__title {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-tightest);
    color: var(--color-text);
    max-width: 830px;
  }

  .showreel-sec__title-muted {
    color: var(--color-text-muted);
  }

  .showreel-sec__subtitle {
    margin-top: var(--space-5);
    max-width: 24rem;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-secondary);
  }

  .showreel-sec__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .showreel-sec__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    margin-bottom: 4px;
  }

  /* [measured] white card 335x171, radius 18 */
  .showreel-sec__step {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 30px;
    padding: var(--space-7) var(--space-6);
    border-radius: 18px;
    background: var(--color-accent);
    border: 1px solid var(--color-border);
    min-height: 171px;
  }

  .showreel-sec__step-num {
    align-self: flex-end;
    font-size: 10px;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tightest);
    color: var(--color-accent-ink);
    opacity: 0.5;
  }

  .showreel-sec__step-text {
    font-family: var(--font-body);
    /* [measured] 18px/500 */
    font-size: 18px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    line-height: 1.3;
    color: var(--color-accent-ink);
    max-width: 204px;
  }

  /* Poster card — radius 25px, relative for overlay */
  .showreel-sec__media {
    position: relative;
    border-radius: 25px;
    overflow: hidden;
    background: var(--color-bg-black);
  }

  .showreel-sec__poster {
    width: 100%;
    aspect-ratio: 1353 / 840;
    object-fit: cover;
    display: block;
  }

  /* --- Testimonials --- */
  .testimonials__top {
    display: grid;
    grid-template-columns: 335px 1fr;
    gap: var(--gutter);
    align-items: end;
    margin-bottom: var(--space-10);
  }

  .testimonials__eyebrow {
    align-self: start;
  }

  .testimonials__title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tighter);
    letter-spacing: var(--ls-tightest);
    color: var(--color-text);
  }

  .testimonials__year {
    font-size: 36px;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tightest);
    color: var(--color-text);
    margin-left: var(--space-4);
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: 335px 1fr 1fr 1fr;
    gap: 4px;
    align-items: stretch;
  }

  /* [measured] white intro card radius 18, 335x630 */
  .testimonials__intro {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-7);
    padding: var(--space-7) var(--space-6);
    border-radius: 18px;
    background: var(--color-accent);
    border: 1px solid var(--color-border);
    min-height: 630px; /* [CDP-verified] live intro card height at 1440 */
  }

  .testimonials__intro-top {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .testimonials__score {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .testimonials__score-value {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tightest);
    line-height: 1;
    color: var(--color-accent-ink);
  }

  .testimonials__score-max {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    color: var(--color-accent-ink);
  }

  .testimonials__lead {
    font-size: 16px;
    line-height: 1.4;
    color: var(--color-accent-ink);
  }

  .testimonials__lead strong {
    font-weight: var(--fw-semibold);
  }

  .testimonials__bottom {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .testimonials__trusted {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .testimonials__logo {
