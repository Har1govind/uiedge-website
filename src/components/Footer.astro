---
/**
 * Footer — global footer.
 * Top: newsletter intro copy + founder placeholder card + Newsletter form
 * (Name/Email/Subscribe). Links: email, Navigation (Home/Studio/Projects/
 * Blog), Social (LinkedIn/Instagram). Giant logo mark.
 * Bottom: © 2026 … · Privacy Policy · Terms of Service.
 */
import { SITE, CONTACT, SOCIALS, LEGAL_LINKS, FOOTER_NAV } from "../data/site";
---

<footer class="site-footer">
  <!-- Top: newsletter + contact -->
  <div class="container site-footer__top">
    <div class="site-footer__newsletter">
      <p class="site-footer__newsletter-text">
        <span class="site-footer__newsletter-muted">
          Whether you’re looking to build a website, an app, or a SaaS product,
        </span>
        we’re here to help.
      </p>

      <div class="site-footer__manager">
        <img
          class="site-footer__manager-photo"
          src="/images/small-84x85.jpg"
          alt="Portrait of the founder at UiEdge"
          width="84"
          height="85"
          loading="lazy"
          decoding="async"
        />
        <div class="site-footer__manager-meta">
          <p class="site-footer__manager-name">⟨Founder name⟩</p>
          <p class="site-footer__manager-role">Founder at UiEdge</p>
        </div>
      </div>
    </div>

    <div class="site-footer__newsletter-form-wrap">
      <h2 class="site-footer__newsletter-title">Newsletter</h2>
      <form class="site-footer__form" data-newsletter>
        <label class="sr-only" for="footer-name">Your name</label>
        <input class="site-footer__input" id="footer-name" type="text" name="Name" placeholder="Your name *" required />
        <label class="sr-only" for="footer-email">Email address</label>
        <input class="site-footer__input" id="footer-email" type="email" name="Email" placeholder="Email *" required />
        <button class="btn btn--dark site-footer__subscribe" type="submit">Subscribe</button>
      </form>
    </div>
  </div>

  <!-- Links: contact + nav + social -->
  <div class="container site-footer__links">
    <div class="site-footer__contact">
      <span class="site-footer__plus" aria-hidden="true"></span>
      <div class="site-footer__contact-meta">
        <a class="site-footer__email" href={CONTACT.email.href}>{CONTACT.email.label}</a>
      </div>
    </div>

    <div class="site-footer__cols">
      <nav class="site-footer__col" aria-label="Footer navigation">
        <p class="site-footer__col-title">Navigation</p>
        <ul class="site-footer__list">
          {
            FOOTER_NAV.map((link) => (
              <li>
                <a class="site-footer__link" href={link.href}>
                  <span class="site-footer__dot" aria-hidden="true"></span>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__col">
        <p class="site-footer__col-title">Social</p>
        <ul class="site-footer__list">
          {
            SOCIALS.map((social) => (
              <li>
                <a class="site-footer__link" href={social.url} target="_blank" rel="noopener noreferrer">
                  {social.label}
                  <span class="site-footer__arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- Logo mark -->
  <div class="container site-footer__brand">
    <img class="site-footer__logo-mark" src="/images/logo/uiedge-black.png" alt="UiEdge" width="120" height="120" loading="lazy" decoding="async" />
  </div>

  <!-- Bottom bar -->
  <div class="container site-footer__bottom">
    <p class="site-footer__copyright">{SITE.copyright}</p>
    <div class="site-footer__legal">
      {
        LEGAL_LINKS.map((link) => (
          <a class="site-footer__legal-link" href={link.href}>{link.label}</a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg);
    padding-block: var(--space-11) var(--space-8);
  }

  /* --- Top --- */
  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    padding-bottom: var(--space-11);
  }

  .site-footer__newsletter {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
    padding-right: var(--space-10);
  }

  .site-footer__newsletter-text {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    line-height: 1.2;
    color: var(--color-text);
    max-width: 34rem;
  }

  .site-footer__newsletter-muted {
    color: var(--color-text-muted);
  }

  .site-footer__manager {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .site-footer__manager-photo {
    width: 84px;
    height: 85px;
    border-radius: 50%;
    object-fit: cover;
  }

  .site-footer__manager-name {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .site-footer__manager-role {
    font-size: var(--fs-label);
    color: var(--color-text-muted);
  }

  .site-footer__newsletter-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-display);
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .site-footer__form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .site-footer__input {
    width: 100%;
    max-width: 30rem;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border-strong);
    font-size: var(--fs-body);
    color: var(--color-text);
    background: transparent;
  }

  .site-footer__input::placeholder {
    color: var(--color-text-muted);
  }

  .site-footer__input:focus-visible {
    outline: none;
    border-color: var(--color-accent-ink);
  }

  .site-footer__subscribe {
    margin-top: var(--space-3);
    font-size: var(--fs-body);
    padding: var(--space-3) var(--space-7);
  }

  /* --- Links --- */
  .site-footer__links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    padding-block: var(--space-10);
    border-top: 1px solid var(--color-border-soft);
  }

  .site-footer__contact {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
  }

  .site-footer__plus {
    position: relative;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid var(--color-text);
    flex-shrink: 0;
    margin-top: 8px;
  }

  .site-footer__plus::before,
  .site-footer__plus::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--color-text);
  }

  .site-footer__plus::before {
    width: 8px;
    height: 1px;
    transform: translate(-50%, -50%);
  }

  .site-footer__plus::after {
    width: 1px;
    height: 8px;
    transform: translate(-50%, -50%);
  }

  .site-footer__contact-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-footer__phone {
    font-size: var(--fs-h5);
    color: var(--color-text);
  }

  .site-footer__phone a:hover {
    color: var(--color-text);
    opacity: 0.7;
  }

  .site-footer__email {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tighter);
    line-height: 1.1;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-text);
    padding-bottom: 2px;
    width: fit-content;
  }

  .site-footer__email:hover {
    color: var(--color-text);
    opacity: 0.7;
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  .site-footer__col-title {
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-display);
    color: var(--color-text);
    margin-bottom: var(--space-5);
  }

  .site-footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-h5);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    color: var(--color-text);
  }

  .site-footer__link:hover,
  .site-footer__link:focus-visible {
    color: var(--color-text);
    opacity: 0.7;
  }

  .site-footer__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent-ink);
    opacity: 0;
  }

  .site-footer__arrow {
    font-size: var(--fs-label);
    opacity: 0.4;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .site-footer__link:hover .site-footer__arrow {
    transform: translate(2px, -2px);
  }

  /* --- Logo mark --- */
  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-block: var(--space-11);
  }

  .site-footer__logo-mark {
    width: clamp(80px, 10vw, 120px);
    height: clamp(80px, 10vw, 120px);
    object-fit: contain;
  }

  /* --- Bottom --- */
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-soft);
    font-size: var(--fs-label);
    color: var(--color-text-muted);
  }

  .site-footer__legal {
    display: flex;
    gap: var(--space-6);
  }

  .site-footer__legal-link {
    color: var(--color-text-secondary);
  }

  .site-footer__legal-link:hover {
    color: var(--color-accent-ink);
  }

  .site-footer__credit {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .site-footer__credit-link {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-border-strong);
  }

  .site-footer__credit-link:hover,
  .site-footer__credit-link:focus-visible {
    color: var(--color-accent-ink);
    text-decoration-color: var(--color-accent-ink);
  }

  /* Responsive */
  @media (max-width: 1199px) {
    .site-footer__top,
    .site-footer__links {
      grid-template-columns: 1fr;
    }

    .site-footer__newsletter {
      padding-right: 0;
    }
  }

  @media (max-width: 809px) {
    .site-footer__cols {
      grid-template-columns: 1fr;
    }

    .site-footer__email {
      font-size: var(--fs-h3);
    }

    .site-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-footer__logo-mark {
      width: 72px;
      height: 72px;
    }
  }
</style>

<script>
  const newsletter = document.querySelector<HTMLFormElement>("[data-newsletter]");
  if (newsletter) {
    newsletter.addEventListener("submit", (event) => {
      event.preventDefault();
      const btn = newsletter.querySelector<HTMLButtonElement>(".site-footer__subscribe");
      const input = newsletter.querySelector<HTMLInputElement>("input[type='email']");
      if (input && !input.checkValidity()) {
        input.reportValidity();
        return;
      }
      if (btn) {
        btn.textContent = "Subscribed ✓";
        btn.disabled = true;
      }
      if (input) input.value = "";
    });
  }
</script>
