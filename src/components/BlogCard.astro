---
/**
 * BlogCard — homepage blog preview card.
 * [measured live] White card (radius 18px), date (11px), title (28px/500),
 * excerpt (14px/500 opacity .6), arrow link.
 */
import type { BlogPost } from "../data/blog";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<article class="blog-card">
  <a class="blog-card__link" href={`/blog/${post.slug}`}>
    <p class="blog-card__date">{post.date}</p>
    <h3 class="blog-card__title">{post.title}</h3>
    <p class="blog-card__excerpt">{post.excerpt}</p>
    <span class="blog-card__more" aria-hidden="true">
      <svg viewBox="0 0 10 11" width="10" height="11" fill="none">
        <path
          d="M1.5.8V1.4c0 .1 0 .2.1.3.1 0 .1 0 .2 0h6.1L.1 9.5c-.1 0-.1.2 0 .3l.5.6c.1.1.3.1.4 0L8.8 2.6v6.1c0 .1 0 .2.1.3.1 0 .2 0 .3 0H9.7c.2 0 .3-.1.3-.3V.8c0-.1-.1-.2-.3-.2H1.8c-.2 0-.3.1-.3.2Z"
          fill="currentColor"
          opacity="0.3"
        />
      </svg>
      <svg viewBox="0 0 10 11" width="10" height="11" fill="none">
        <path
          d="M1.5.8V1.4c0 .1 0 .2.1.3.1 0 .1 0 .2 0h6.1L.1 9.5c-.1 0-.1.2 0 .3l.5.6c.1.1.3.1.4 0L8.8 2.6v6.1c0 .1 0 .2.1.3.1 0 .2 0 .3 0H9.7c.2 0 .3-.1.3-.3V.8c0-.1-.1-.2-.3-.2H1.8c-.2 0-.3.1-.3.2Z"
          fill="currentColor"
        />
      </svg>
    </span>
  </a>
</article>

<style>
  .blog-card__link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-7);
    border-radius: 18px;
    background: var(--color-accent);
    border: 1px solid var(--color-border);
    transition: transform var(--dur) var(--ease-out);
  }

  .blog-card__link:hover,
  .blog-card__link:focus-visible {
    transform: translateY(-4px);
  }

  .blog-card__date {
    font-size: var(--fs-caption);
    color: var(--color-accent-ink);
    opacity: 0.6;
  }

  .blog-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    line-height: 1.2;
    letter-spacing: var(--ls-display);
    color: var(--color-accent-ink);
  }

  .blog-card__link:hover .blog-card__title {
    opacity: 0.7;
  }

  .blog-card__excerpt {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--color-accent-ink);
    opacity: 0.6;
  }

  .blog-card__more {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-top: auto;
    padding-top: var(--space-4);
    color: var(--color-accent-ink);
    transition: gap var(--dur-fast) var(--ease-out);
  }

  .blog-card__link:hover .blog-card__more {
    gap: 6px;
  }
</style>
