---
/**
 * TeamCard — compact team member card.
 * [measured live] 220x358 card: photo fills the card, name (Inter 600 15px)
 * + role overlaid near the bottom.
 */
import type { TeamMember } from "../data/team";

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
---

<article class="team-card">
  <div class="team-card__media">
    <img
      src={member.photo}
      alt={`Portrait of ${member.name}`}
      width="220"
      height="358"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="team-card__scrim" aria-hidden="true"></div>
  <div class="team-card__body">
    <p class="team-card__name">{member.name}</p>
    <p class="team-card__role">{member.role}</p>
  </div>
</article>

<style>
  /* [measured] card 220x358, radius 18, photo fills */
  .team-card {
    position: relative;
    aspect-ratio: 220 / 358;
    border-radius: 18px;
    overflow: hidden;
    background: var(--color-surface);
  }

  .team-card__media {
    position: absolute;
    inset: 0;
  }

  .team-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .team-card:hover .team-card__media img {
    transform: scale(1.04);
  }

  .team-card__scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 45%;
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0));
    mask-image: linear-gradient(to top, black 20%, transparent 100%);
    -webkit-mask-image: linear-gradient(to top, black 20%, transparent 100%);
    pointer-events: none;
  }

  .team-card__body {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .team-card__name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-display);
    line-height: 1.2;
    color: var(--color-text-inverse);
  }

  .team-card__role {
    font-size: var(--fs-caption);
    line-height: 1.3;
    color: var(--color-text-inverse-secondary);
  }
</style>
