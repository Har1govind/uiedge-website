---
/**
 * ProjectCard — homepage project grid card.
 * [measured] White card, radius 18px, gap 4px in the grid.
 * Header: 58px, padding 18px 24px — project name (Inter 600 15px),
 * "/year" (Inter 500 12px, opacity .6), 3 dots (8px).
 * Image below at 750x540.
 */
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
  <a class="project-card__link" href={`/projects/${project.slug}`}>
    <div class="project-card__header">
      <div class="project-card__info">
        <h3 class="project-card__title">{project.title}.</h3>
        <div class="project-card__year">
          <span aria-hidden="true">/</span>
          <span>{project.year}</span>
        </div>
      </div>
      <div class="project-card__dots" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>

    <div class="project-card__media">
      <img
        class="project-card__image"
        src={project.image}
        alt={`${project.title} project preview`}
        width="750"
        height="540"
        loading="lazy"
        decoding="async"
      />
      <img class="project-card__logo" src={project.logo} alt={`${project.title} logo`} loading="lazy" decoding="async" />
    </div>
  </a>
</article>

<style>
  /* [measured] card: column, gap 4px, white bg, radius 18px */
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .project-card__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
  }

  /* [measured] header: 58px tall, padding 18px 24px, radius 18px, white */
  .project-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 58px;
    padding: 18px 24px;
    border-radius: 18px;
    background: var(--color-accent);
    border: 1px solid var(--color-border);
  }

  .project-card__info {
    display: flex;
    align-items: baseline;
    gap: 18px;
    min-width: 0;
  }

  /* [measured] name Inter 600 15px, near-black on white */
  .project-card__title {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-display);
    line-height: 1.2;
    color: var(--color-accent-ink);
    white-space: nowrap;
  }

  /* [measured] /year Inter 500 12px, opacity .6 */
  .project-card__year {
    display: flex;
    gap: 0;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    line-height: 1.3;
    color: var(--color-accent-ink);
    opacity: 0.6;
    white-space: nowrap;
  }

  /* [measured] 3 dots, 8px, gap 3px */
  .project-card__dots {
    display: flex;
    align-items: center;
    gap: 3px;
    flex-shrink: 0;
  }

  .project-card__dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent-ink);
    opacity: 0.6;
  }

  /* Image — [measured] 750x540, radius 18px */
  .project-card__media {
    position: relative;
    aspect-ratio: 750 / 540;
    border-radius: 18px;
    overflow: hidden;
    background: var(--color-surface);
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .project-card__link:hover .project-card__image {
    transform: scale(1.03);
  }

  .project-card__logo {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    height: 34px;
    width: auto;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
    opacity: 0.9;
  }

  @media (max-width: 809px) {
    .project-card__header {
      padding: 14px 18px;
    }
  }
</style>
