---
/**
 * Showreel — poster card overlay + modal video player.
 * [measured live 1440] Poster card 1353x840 radius 25px; centered play
 * button + "Watch showreel" (30px/600) + "©" (14px) overlay.
 */
---

<div class="showreel" data-showreel>
  <button class="showreel__button" type="button" aria-haspopup="dialog" aria-label="Watch showreel" data-showreel-open>
    <span class="showreel__icon" aria-hidden="true">
      <svg viewBox="0 0 92 92" width="100%" height="100%" fill="none" aria-hidden="true">
        <circle cx="46" cy="46" r="46" fill="#fff" />
        <path d="M38 30v32l28-16z" fill="#0a0a0a" />
      </svg>
    </span>
    <span class="showreel__text">Watch showreel</span>
    <span class="showreel__years">©</span>
  </button>
</div>

<!-- Modal -->
<div class="showreel__modal" data-showreel-modal hidden>
  <button class="showreel__backdrop" type="button" tabindex="-1" aria-label="Close video" data-showreel-close></button>
  <div class="showreel__dialog" role="dialog" aria-modal="true" aria-label="Showreel video">
    <button class="showreel__close" type="button" aria-label="Close video" data-showreel-close>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
    <video
      class="showreel__video"
      src="/videos/showreel.mp4"
      controls
      preload="none"
      playsinline
      data-showreel-video
    ></video>
  </div>
</div>

<style>
  .showreel {
    display: flex;
  }

  /* Full-poster overlay button */
  .showreel__button {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    cursor: pointer;
  }

  .showreel__icon {
    display: block;
    width: 92px;
    height: 92px;
  }

  .showreel__text {
    font-family: var(--font-body);
    /* [measured] 30px/600 */
    font-size: 30px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.04em;
    line-height: 1.25;
    color: var(--color-text-inverse);
  }

  .showreel__years {
    font-size: 14px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    color: var(--color-text-inverse);
    opacity: 0.6;
    margin-top: -14px;
  }

  /* Modal */
  .showreel__modal {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-header) + 10);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .showreel__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .showreel__dialog {
    position: relative;
    width: min(920px, 100%);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border-inverse);
  }

  .showreel__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(9, 9, 9, 0.7);
    color: var(--color-text-inverse);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .showreel__close:hover {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .showreel__video {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: block;
    background: #000;
  }
</style>

<script>
  const root = document.querySelector("[data-showreel]");
  const openBtn = root?.querySelector<HTMLButtonElement>("[data-showreel-open]");
  const modal = root?.querySelector<HTMLElement>("[data-showreel-modal]");
  const video = root?.querySelector<HTMLVideoElement>("[data-showreel-video]");
  const closeBtns = modal ? Array.from(modal.querySelectorAll<HTMLButtonElement>("[data-showreel-close]")) : [];

  if (openBtn && modal && video) {
    const open = () => {
      modal.hidden = false;
      document.body.classList.add("no-scroll");
      video.play().catch(() => {});
    };

    const close = () => {
      video.pause();
      video.currentTime = 0;
      document.body.classList.remove("no-scroll");
      modal.hidden = true;
      openBtn.focus();
    };

    openBtn.addEventListener("click", open);
    closeBtns.forEach((btn) => btn.addEventListener("click", close));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !modal.hidden) close();
    });
  }
</script>
