---
/**
 * StatsSection — "Advantages" / Why choose us band.
 * [measured live 1440] Container: Top row = "Why choose us" (335px) +
 * "No inflated numbers, just what actually makes UiEdge a safe bet."
 * (60px heading). Content row = 3 cols: CTA card (335x621, radius 18px,
 * portrait bg + blackout 0.2 + plus button; text 16px white + "Book a
 * strategy call" dark pill) | filler (335px) | items (675px): "Depth over
 * volume." (22px) + 2 white stat cards side by side (45px value
 * /600/-0.07em, "01" badge 10px, right-aligned 18px title, 14px copy).
 */
import Counter from "./atoms/Counter.astro";
import { CTA } from "../data/site";
---

<section class="why">
  <div class="container why__shell">
    <div class="why__top">
      <p class="why__eyebrow">Why choose us</p>
      <h2 class="why__title">
        No inflated numbers,
        <span class="why__title-muted">just what actually makes UiEdge a safe bet.</span>
      </h2>
    </div>

    <div class="why__content">
      <div class="why__cta-card">
        <div class="why__cta-bg">
          <div class="why__cta-blackout" aria-hidden="true"></div>
          <img
            class="why__cta-image"
            src="/images/hero-portrait.jpg"
            alt=""
            width="566"
            height="932"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="why__cta-text">Your product journey starts with a conversation. Book a free 30-minute strategy call.</p>
        <a class="why__cta-btn" href={CTA.href}>
          <span>{CTA.label}</span>
        </a>
        <span class="why__cta-plus" aria-hidden="true"></span>
      </div>

      <div class="why__filler" aria-hidden="true"></div>

      <div class="why__items">
        <p class="why__quote">Depth over volume.</p>
        <p class="why__text">
          We're a young studio and we work that way on purpose — a transparent process, and a track record of building software we run ourselves, not just design we hand off.
        </p>

        <div class="why__stats">
          <div class="why__stat">
            <div class="why__stat-top">
              <span class="why__stat-value"><Counter value={9} /></span>
              <span class="why__stat-num">01</span>
            </div>
            <div class="why__stat-bottom">
              <p class="why__stat-label">A proven, transparent delivery process</p>
              <p class="why__stat-copy">From discovery to optimization, every project follows the same 9-step process — no guesswork.</p>
            </div>
          </div>

          <div class="why__stat">
            <div class="why__stat-top">
              <span class="why__stat-value"><Counter value={2} /></span>
              <span class="why__stat-num">02</span>
            </div>
            <div class="why__stat-bottom">
              <p class="why__stat-label">Software products we build and run ourselves</p>
              <p class="why__stat-copy">A veterinary management platform and a POS system — proof we think in products, not just deliverables.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .why {
    padding-block: 0;
    background: var(--color-bg);
  }

  .why__shell {
    display: flex;
    flex-direction: column;
    gap: 120px;
  }

  /* Top row — eyebrow + heading */
  .why__top {
    display: grid;
    grid-template-columns: 335px 1fr;
    gap: var(--gutter);
    align-items: start;
  }

  .why__eyebrow {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    color: var(--color-text);
  }

  /* [measured] 60px/600/-0.06em */
  .why__title {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-tightest);
    color: var(--color-text);
    max-width: 830px;
  }

  .why__title-muted {
    color: var(--color-text-muted);
  }

  /* Content row — CTA card | filler | items */
  .why__content {
    display: grid;
    grid-template-columns: 335px 335px 1fr;
    gap: var(--gutter);
    align-items: stretch;
  }

  /* CTA card — portrait bg, blackout 0.2, radius 18px */
  .why__cta-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 26px;
    padding: var(--space-7) var(--space-6);
    border-radius: 18px;
    background: var(--color-bg-black);
    overflow: hidden;
    min-height: 621px;
  }

  .why__cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .why__cta-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .why__cta-blackout {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--color-bg-black);
    opacity: 0.2;
  }

  /* [measured] 16px/500, white */
  .why__cta-text {
    position: relative;
    z-index: 2;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    line-height: 1.4;
    color: var(--color-text-inverse);
    max-width: 270px;
  }

  /* [measured] dark pill, 12px/600, with white dots */
  .why__cta-btn {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 9px 12px 9px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-bg-black);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-display);
    line-height: 1;
    color: var(--color-text-inverse);
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .why__cta-btn:hover {
    color: var(--color-text-inverse);
    opacity: 0.85;
  }

  .why__cta-btn::after {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-text-inverse);
  }

  /* Plus icon button — top-right */
  .why__cta-plus {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    z-index: 2;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-bg-black);
  }

  .why__cta-plus::before,
  .why__cta-plus::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--color-text-inverse);
    transform: translate(-50%, -50%);
  }

  .why__cta-plus::before {
    width: 14px;
    height: 2px;
  }

  .why__cta-plus::after {
    width: 2px;
    height: 14px;
  }

  .why__filler {
    min-height: 621px;
  }

  /* Items — quote + text + stat cards */
  .why__items {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  /* [measured] 22px/500 */
  .why__quote {
    font-family: var(--font-body);
    font-size: 22px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    line-height: 1.2;
    color: var(--color-text);
  }

  .why__text {
    max-width: 28rem;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-secondary);
    margin-top: -60px;
  }

  .why__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }

  .why__stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-6);
    border-radius: 18px;
    background: var(--color-accent);
    border: 1px solid var(--color-border);
    min-height: 462px;
  }

  .why__stat-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  /* [measured] 45px/600/-0.07em */
  .why__stat-value {
    font-family: var(--font-body);
    font-size: 45px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.07em;
    line-height: 1;
    color: var(--color-accent-ink);
  }

  .why__stat-num {
    font-size: 10px;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tightest);
    color: var(--color-accent-ink);
    opacity: 0.5;
  }

  .why__stat-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
  }

  /* [measured] 18px/500, right-aligned */
  .why__stat-label {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-display);
    line-height: 1.3;
    text-align: right;
    color: var(--color-accent-ink);
  }

  .why__stat-copy {
    font-size: 14px;
    line-height: var(--lh-body);
    color: var(--color-accent-ink);
    opacity: 0.6;
  }

  @media (max-width: 1199px) {
    .why__top {
      grid-template-columns: 1fr;
    }

    .why__content {
      grid-template-columns: 1fr 1fr;
    }

    .why__filler {
      display: none;
    }

    .why__items {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 809px) {
    .why__shell {
      gap: 60px;
    }

    .why__title {
      font-size: var(--fs-h2);
    }

    .why__content {
      grid-template-columns: 1fr;
    }

    .why__cta-card {
      min-height: 380px;
    }

    .why__filler {
      display: none;
    }

    .why__items {
      gap: 40px;
    }

    .why__text {
      margin-top: 0;
    }

    .why__stats {
      grid-template-columns: 1fr;
    }

    .why__stat {
      min-height: auto;
    }
  }
</style>
